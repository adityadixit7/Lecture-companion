
{
  "manifest_version": 3,
  "name": "UPSC Lecture Companion",
  "version": "0.3.1",
  "description": "A user-controlled slide companion with AI draft summaries, approved notes, stars, and research shortcuts.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Open UPSC Lecture Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
